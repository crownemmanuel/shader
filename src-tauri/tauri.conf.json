{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shader",
  "version": "../package.json",
  "identifier": "studio.shader.desktop",
  "build": {
    "beforeDevCommand": "npm run bundle:engine && npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node scripts/fetch-ffmpeg.ts && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Shader",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/shader-engine",
      "binaries/ffmpeg"
    ],
    "macOS": {
      "minimumSystemVersion": "12.1",
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/sony/": "sony/",
      "../scripts/FFMPEG-NOTICE.txt": "FFMPEG-NOTICE.txt"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4NEY1REY0NUM3MkY0NUMKUldSYzlISmM5RjFQK05tMXRKNDgyUCtqMmtPMkIyeUZJd2w3ZVUveWJhQTByVitoZFpTam9PS20K",
      "endpoints": [
        "https://github.com/crownemmanuel/shader/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
