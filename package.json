{
  "name": "shader-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "tauri dev",
    "build": "tsc --noEmit && vite build",
    "engine": "tsx engine/main.ts",
    "mcp": "tsx engine/main.ts --mcp",
    "test": "tsx --test engine/tests/*.test.ts",
    "check": "tsc --noEmit",
    "bundle:engine": "node scripts/bundle-engine.mjs",
    "desktop:build": "npm run build:sony && npm run bundle:engine && tauri build",
    "tauri": "tauri",
    "build:sony": "node native/sony/build.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tauri-apps/api": "^2.10.1",
    "atem-connection": "^3.10.3",
    "bonjour-service": "^1.3.0",
    "digest-fetch": "^3.1.1",
    "fast-xml-parser": "^5.3.0",
    "lucide-react": "^0.468.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "esbuild": "^0.28.2",
    "node": "^26.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5"
  }
}
